# fleet-monitor deploy image: uses the PRE-BUILT client (client/dist, arch-independent)
# so we skip the memory-hungry vite build — build this for linux/amd64 on a Mac
# with `docker buildx build --platform linux/amd64` and run it on the VPS.
# Runtime uses node's built-in node:sqlite (no native modules), so npm ci pulls
# pure-JS deps only.
#
# Build:  cd client && npm run build          # produces client/dist
#         cp -r client/dist docker-dist        # stage it past .dockerignore
#         docker buildx build --platform linux/amd64 -f Dockerfile.deploy \
#           -t claude-fleet-ccam:latest --load .
#
# Runtime env the container REQUIRES (supply via compose/`docker run`, not baked
# here): DASHBOARD_DATA_DIR=/app/data, DASHBOARD_HOST=0.0.0.0 (else it binds
# loopback inside the container and the published port is unreachable),
# DASHBOARD_TOKEN, DASHBOARD_ALLOWED_HOSTS (else hostGuard 403s every request).
# See claude-fleet-monitor/deploy/docker-compose.yml.
FROM node:22-alpine
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev

COPY server/ ./server/
COPY scripts/ ./scripts/
COPY statusline/ ./statusline/
# client/dist is in .dockerignore (stock image builds it in-container); we ship
# the pre-built dist via a staging copy the ignore file doesn't cover.
COPY docker-dist ./client/dist/

RUN mkdir -p data
EXPOSE 4820
ENV NODE_ENV=production
CMD ["node", "server/index.js"]
